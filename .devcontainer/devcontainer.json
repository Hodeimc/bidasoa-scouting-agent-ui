{
  "name": "Agente Streamlit (Bidasoa FC · Scouting)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postAttachCommand": {
    "app": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false",
    "login": "bash .devcontainer/login-azure.sh"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "App Streamlit",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
